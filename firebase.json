{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "hosting": {
    "public": "public",
    "predeploy": [
      "npm --prefix app run build"
    ],
    "ignore": [
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|png|svg|webp)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/app/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/app/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/facebook-callback",
        "function": {
          "functionId": "facebookOAuthCallback",
          "region": "us-central1"
        }
      },
      {
        "source": "/youtube-callback",
        "function": {
          "functionId": "youtubeOAuthCallback",
          "region": "us-central1"
        }
      },
      {
        "source": "/login",
        "destination": "/app/index.html"
      },
      {
        "source": "/invite/**",
        "destination": "/app/index.html"
      },
      {
        "source": "/admin",
        "destination": "/app/index.html"
      },
      {
        "source": "/admin/**",
        "destination": "/app/index.html"
      },
      {
        "source": "/share/**",
        "destination": "/app/index.html"
      },
      {
        "source": "/newsletter/**",
        "destination": "/app/index.html"
      },
      {
        "source": "/share",
        "destination": "/app/index.html"
      },
      {
        "source": "/newsletter",
        "destination": "/app/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/live",
        "destination": "/#live",
        "type": 302
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "functions": {
      "port": 5001
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
